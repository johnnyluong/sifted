# Copy to .env. Blank values fall back to the defaults shown in sift/config.py.
ANTHROPIC_API_KEY=
# anthropic (real) or fake (keyword rules, no key needed; for trying the app)
LLM_BACKEND=anthropic
EXTRACT_MODEL=claude-sonnet-5-5
# Defaults to EXTRACT_MODEL; set claude-haiku-5-5 to score more cheaply.
SCORE_MODEL=
DIGEST_MODEL=claude-sonnet-5-5
LLM_EFFORT=medium

# Telegram is not built yet; use the paste box in the web app.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Browser holding the secondary Instagram account's session (chrome, firefox, safari, brave, ...)
COOKIES_BROWSER=chrome
COOKIES_BROWSER_PROFILE=
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

KEEP_THRESHOLD=60
KEEP_MEDIA=false
FETCH_DELAY_SECONDS=20
# Day names, not numbers: APScheduler counts weekdays from Monday.
DIGEST_CRON=0 18 * * SUN
TIMEZONE=America/New_York
WEB_HOST=127.0.0.1
WEB_PORT=8000
DATA_DIR=./data
